{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal offline capabilities for CipherPass (clipboard + native file dialog only, zero network)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-clear",
    "clipboard-manager:allow-read-text"
  ]
}
